    "test": "node --test \"tests/*.test.js\"",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.319",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "multer": "^2.5.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@anthropic-ai/claude-code@2.1.319": true
  }
